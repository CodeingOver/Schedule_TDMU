<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Keep Light Mode consistent even when system dark mode is active -->
    <style name="Base.Theme.Schedule_TDMU" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/surface_container_lowest</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>