<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Header chuẩn thiết kế Google Stitch -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="@color/surface_container_lowest"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Logo EduSchedule SVG -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="EduSchedule Logo"
            android:src="@drawable/ic_eduschedule_logo" />

        <!-- Tiêu đề & Badge Tuần học -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EduSchedule"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời Khóa Biểu"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_week_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Hôm nay"
                    android:textColor="@color/on_secondary_fixed"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút Chuông Thông báo nhanh có chấm đỏ -->
        <FrameLayout
            android:id="@+id/btn_header_bell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Thông báo nhanh"
                android:src="@drawable/ic_notifications"
                app:tint="@color/text_secondary" />

            <View
                android:id="@+id/view_header_unread_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_dot"
                android:backgroundTint="@color/error"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Avatar Sinh viên tròn -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_header_profile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_fixed"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Hồ sơ sinh viên"
                android:scaleType="centerCrop"
                android:src="@drawable/img_student_avatar" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Container chứa Fragment -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation_card"
        android:layout_below="@id/header_bar" />

    <!-- Thanh điều hướng đáy nổi bo tròn theo phong cách Stitch -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/surface_container_high"
        app:strokeWidth="1dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:minHeight="66dp"
            app:compatShadowEnabled="false"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconSize="22dp"
            app:itemIconTint="@drawable/color_bottom_nav"
            app:itemPaddingBottom="8dp"
            app:itemPaddingTop="8dp"
            app:itemTextColor="@drawable/color_bottom_nav"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>