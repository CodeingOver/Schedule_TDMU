<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item_lich"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/primary"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Dải màu chỉ thị môn học bên trái -->
        <View
            android:id="@+id/view_color_strip"
            android:layout_width="6dp"
            android:layout_height="64dp"
            android:background="@color/primary" />

        <!-- CheckBox chọn hàng loạt -->
        <CheckBox
            android:id="@+id/cb_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <!-- CỘT 1 (BÊN TRÁI): Cột Mốc Thời Gian & Ca Học -->
        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tiet_hoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:00 - 15:30"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_buoi_ca_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_bg_blue"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Ca 3 • Tiết 7-9"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/primary"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Sắp diễn ra"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Đường kẻ phân cách dịu nhẹ giữa 2 cột -->
        <View
            android:layout_width="1dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="10dp"
            android:background="@color/surface_container_high" />

        <!-- CỘT 2 (BÊN PHẢI): Thông tin Môn Học & Phòng Học Pastel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ten_mon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="An ninh mạng"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ma_mon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/primary_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="CNTT001"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Badge Phòng Học Nổi Bật -->
                <TextView
                    android:id="@+id/tv_phong_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/card_bg_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Phòng I4.112"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_giang_vien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="GV: L.T.M.Trí"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_thu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Thứ 2 (19/10)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>